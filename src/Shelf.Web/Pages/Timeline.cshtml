@page "/"
@model Shelf.Web.Pages.TimelineModel
@{
    ViewData["Title"] = "Timeline";
}

<h1>Timeline</h1>

<form method="get" class="row row-cols-auto g-2 align-items-end mb-3">
    <div class="col">
        <label class="form-label" for="Period">Period</label>
        <select class="form-select" id="Period" name="Period" onchange="this.form.submit()">
            <option value="24h" selected="@(Model.Period == "24h" ? "selected" : null)">Past 24 hours</option>
            <option value="7d" selected="@(Model.Period == "7d" ? "selected" : null)">Past week</option>
            <option value="30d" selected="@(Model.Period == "30d" ? "selected" : null)">Past month</option>
            <option value="all" selected="@(Model.Period == "all" ? "selected" : null)">All time</option>
        </select>
    </div>
    <div class="col">
        <label class="form-label" for="Type">Event type</label>
        <select class="form-select" id="Type" name="Type" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="added" selected="@(Model.Type == "added" ? "selected" : null)">Added</option>
            <option value="removed" selected="@(Model.Type == "removed" ? "selected" : null)">Removed</option>
            <option value="status" selected="@(Model.Type == "status" ? "selected" : null)">Status change</option>
            <option value="review" selected="@(Model.Type == "review" ? "selected" : null)">Review</option>
            <option value="comment" selected="@(Model.Type == "comment" ? "selected" : null)">Comment</option>
            <option value="recommendation" selected="@(Model.Type == "recommendation" ? "selected" : null)">Recommendation</option>
        </select>
    </div>
    <div class="col">
        <button type="submit" class="btn btn-outline-secondary">Apply</button>
    </div>
</form>

<partial name="_EventList" model="(Model.Events, true)" />
