@page "/stats"
@model Shelf.Web.Pages.StatsModel
@using Shelf.Web.Services
@{
    ViewData["Title"] = "Stats";
}

<h1>Stats</h1>

<form method="get" class="row row-cols-auto g-2 align-items-end mb-3">
    <div class="col">
        <label class="form-label" for="Period">Period</label>
        <select class="form-select" id="Period" name="Period" onchange="this.form.submit()">
            <option value="week" selected="@(Model.Period == "week" ? "selected" : null)">Past week</option>
            <option value="month" selected="@(Model.Period == "month" ? "selected" : null)">Past month</option>
            <option value="year" selected="@(Model.Period == "year" ? "selected" : null)">Past year</option>
            <option value="all" selected="@(Model.Period == "all" ? "selected" : null)">All time</option>
        </select>
    </div>
    <div class="col">
        <button type="submit" class="btn btn-outline-secondary">Apply</button>
    </div>
</form>

@if (Model.Stats.Total == 0)
{
    <p>No items to display.</p>
}
else
{
    <p class="text-muted">@Model.Stats.Total item@(Model.Stats.Total == 1 ? "" : "s") started or finished in this period</p>

    <table class="table table-sm" style="max-width: 30rem;">
        <thead>
            <tr>
                <th>Type</th>
                <th>In Progress</th>
                <th>Finished</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Stats.ByMediaType)
            {
                <tr>
                    <td>@Display.MediaTypeDisplay(row.MediaType)</td>
                    <td>@row.InProgress</td>
                    <td>@row.Finished</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
        @foreach (var item in Model.Stats.Items)
        {
            <div class="col">
                <a asp-page="/Items/Details" asp-route-id="@item.ItemId" class="text-decoration-none text-body">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(item.CoverArtUrl))
                        {
                            <img src="@item.CoverArtUrl" class="card-img-top" alt="" />
                        }
                        else
                        {
                            <div class="cover-placeholder card-img-top d-flex align-items-center justify-content-center">
                                <span>@item.Title.Substring(0, 1).ToUpperInvariant()</span>
                            </div>
                        }
                        <div class="card-body">
                            <h6 class="card-title mb-1">@item.Title</h6>
                            <span class="badge text-bg-primary">@Display.StatusDisplay(item.FurthestStatus)</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
