@page "/add"
@model Shelf.Web.Pages.AddModel
@using Shelf.Web.Data.Entities
@using Shelf.Web.Services
@{
    ViewData["Title"] = "Add";
}

<h1>Add to Shelf</h1>

<form method="get" class="mb-4">
    <div class="btn-group mb-3" role="group" aria-label="Media type">
        @{
            var isAllSelected = Model.MediaType is null;
        }
        <input type="radio" class="btn-check" name="MediaType" id="mt-all" value="" autocomplete="off" checked="@(isAllSelected ? "checked" : null)" />
        <label class="btn btn-outline-primary" for="mt-all">All types</label>
        @foreach (var type in Enum.GetValues<MediaType>())
        {
            var isSelected = Model.MediaType == type;
            <input type="radio" class="btn-check" name="MediaType" id="mt-@type" value="@type" autocomplete="off" checked="@(isSelected ? "checked" : null)" />
            <label class="btn btn-outline-primary" for="mt-@type">@Display.MediaTypeDisplay(type)</label>
        }
    </div>
    <div class="input-group">
        <input type="text" class="form-control" name="Q" value="@Model.Q" placeholder="Search title..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.ErrorMessage is not null)
{
    <p class="text-danger">@Model.ErrorMessage</p>
}
else if (Model.HasSearched)
{
    if (Model.MediaType is null)
    {
        if (Model.Sections.Count == 0)
        {
            <p>No results found for '@Model.Q'.</p>
        }
        else
        {
            foreach (var typeSection in Model.Sections)
            {
                if (typeSection.Failed)
                {
                    <h2 class="h5 mt-4">@Display.MediaTypeDisplay(typeSection.Type)</h2>
                    <p class="text-muted">@Display.MediaTypeDisplay(typeSection.Type) results are unavailable right now.</p>
                }
                else
                {
                    <h2 class="h5 mt-4">@Display.MediaTypeDisplay(typeSection.Type) (@typeSection.TotalCount)</h2>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                        @foreach (var row in typeSection.Rows)
                        {
                            <partial name="_SearchResultCard" model="(row, typeSection.Type)" />
                        }
                    </div>
                    if (typeSection.ShowMoreUrl is not null)
                    {
                        <a href="@typeSection.ShowMoreUrl" class="d-inline-block mt-2">Show more @Display.MediaTypeDisplay(typeSection.Type).ToLowerInvariant() results</a>
                    }
                }
            }
        }
    }
    else if (Model.Results.Count == 0)
    {
        <p>No results found for '@Model.Q'.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            @foreach (var row in Model.Results)
            {
                <partial name="_SearchResultCard" model="(row, Model.MediaType.Value)" />
            }
        </div>
    }
}
